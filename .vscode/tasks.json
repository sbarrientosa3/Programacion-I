{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build & Run in External CMD",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "postExecute": {
                "command": "cmd.exe",
                "args": [
                    "/c",
                    "start",
                    "cmd.exe",
                    "/k",
                    "${fileDirname}\\${fileBasenameNoExtension}.exe"
                ]
            }
        }
    ]
}